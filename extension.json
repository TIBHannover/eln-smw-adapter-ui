{
    "name": "ELNSMWAdapterUI",
    "author": ["Marc Hinterthaner"],
    "url": "https://github.com/TIBHannover/eln-smw-adapter-ui",
    "description": "A MediaWiki Extension to provide a user interface for the eln-smw-adapter endpoint",
    "type": "specialpage",
    "version": "2.0.0",
    "license-name": "MIT",
    "descriptionmsg": "elnsmwadapterui-desc",
    "requires": {
        "MediaWiki": ">= 1.39.0"
    },
    "AutoloadNamespaces": {
        "ELNSMWAdapterUI\\": "includes/"
    },
    "ServiceWiringFiles": [
        "includes/ServiceWiring.php"
    ],
    "SpecialPages": {
        "ELNSMWAdapterUI": {
            "class": "ELNSMWAdapterUI\\SpecialELNSMWAdapterUI",
            "services": ["ConfigFactory", "ELNSMWAdapterUI.AdapterServiceClient"]
        }
    },
    "config": {
        "ELNSMWAdapterUIServiceURL": {
            "value": "http://localhost:5000",
            "description": "URL of the ELN SMW Adapter service endpoint"
        },
        "ELNSMWAdapterUIWikiURL": {
            "value": "",
            "description": "Base URL under which imported pages are linked; when empty, derived from $wgServer and $wgArticlePath"
        },
        "ELNSMWAdapterUIJobStatusPath": {
            "value": "/eln-smw-adapter/job/",
            "description": "Public path, relative to $wgServer, under which the browser can poll the adapter service for job status (job ID is appended)"
        },
        "ELNSMWAdapterUIUploadDir": {
            "value": "/tmp/elnsmwadapterui",
            "description": "Directory for uploaded files"
        },
        "ELNSMWAdapterUIAllowedELabFTWHosts": {
            "value": [],
            "description": "Host names of the eLabFTW instances from which URLs may be imported"
        }
    },
    "GroupPermissions": {
        "user": {
            "elnsmwadapterui-use": true
        },
        "sysop": {
            "elnsmwadapterui-use": true
        }
    },
    "AvailableRights": [
        "elnsmwadapterui-use"
    ],
    "ResourceModules": {
        "ext.elnsmwadapterui.styles": {
            "styles": [
                "modules/ext.elnsmwadapterui.css"
            ]
        },
        "ext.elnsmwadapterui.processing": {
            "scripts": [
                "modules/ext.elnsmwadapterui.processing.js"
            ],
            "messages": [
                "elnsmwadapterui-processing-timeout",
                "elnsmwadapterui-processing-failed",
                "elnsmwadapterui-processing-failed-unknown"
            ]
        }
    },
    "ResourceFileModulePaths": {
        "localBasePath": "",
        "remoteExtPath": "ELNSMWAdapterUI"
    },
    "manifest_version": 2,
    "MessagesDirs": {
        "ELNSMWAdapterUI": [
            "i18n"
        ]
    },
    "ExtensionMessagesFiles": {
        "ELNSMWAdapterUIAlias": "ELNSMWAdapterUI.alias.php"
    }
}