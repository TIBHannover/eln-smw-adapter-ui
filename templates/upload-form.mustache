<div class="elnsmwadapterui-form-container elnsmwadapterui-form">
	<div class="elnsmwadapterui-section">
		<h2 class="elnsmwadapterui-section-title elnsmwadapterui-section__title">{{legend}}</h2>
		<div class="elnsmwadapterui-form-content elnsmwadapterui-form__content">
			<div class="elnsmwadapterui-plugin-info">
				<h3>Import method: {{method}}</h3>
			</div>
			<p class="elnsmwadapterui-form-description elnsmwadapterui-form__description">{{help}}</p>
			<form method="post" enctype="multipart/form-data" action="{{action}}">
				<input type="hidden" name="wpEditToken" value="{{token}}">
				<input type="hidden" name="wpmethod" value="{{method}}">
				<div class="elnsmwadapterui-form-field elnsmwadapterui-form__field">
					<label class="elnsmwadapterui-form-label elnsmwadapterui-form__label">{{label}}</label>
					<div class="elnsmwadapterui-file-upload">
						<input type="file" name="upload-file" class="elnsmwadapterui-file-input elnsmwadapterui-file-upload__input" required>
						<div class="elnsmwadapterui-file-drop-zone elnsmwadapterui-file-upload__drop-zone">
							<div class="elnsmwadapterui-file-icon elnsmwadapterui-file-upload__icon">📄</div>
							<div class="elnsmwadapterui-file-text elnsmwadapterui-file-upload__text">{{dropText}}</div>
						</div>
						<div class="elnsmwadapterui-selected-file elnsmwadapterui-file-upload__selected">
							<span class="elnsmwadapterui-file-name elnsmwadapterui-file-upload__name"></span>
							<button type="button" class="elnsmwadapterui-remove-file elnsmwadapterui-file-upload__remove">×</button>
						</div>
					</div>
				</div>
				{{#fields}}
				{{> dynamic-field}}
				{{/fields}}
				{{> submit-button}}
			</form>
		</div>
	</div>
</div>
