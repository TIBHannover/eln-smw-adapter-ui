<div class="elnsmwadapterui-form-container elnsmwadapterui-form">
	<div class="elnsmwadapterui-status-section elnsmwadapterui-status">
		<h3>Service Status</h3>
		{{#connected}}
		<div class="elnsmwadapterui-status-connected elnsmwadapterui-status__message elnsmwadapterui-status__message--connected">
			<span class="elnsmwadapterui-status__indicator elnsmwadapterui-status__indicator--connected">●</span> Service is running (v{{version}})
			{{#hasSmwConnection}}
			<br><small>SMW Connection: {{smwConnection}}</small>
			{{/hasSmwConnection}}
			{{#hasEnabledPlugins}}
			<br><small>Available plugins: {{enabledPlugins}}</small>
			{{/hasEnabledPlugins}}
		</div>
		{{/connected}}
		{{^connected}}
		<div class="elnsmwadapterui-status-disconnected elnsmwadapterui-status__message elnsmwadapterui-status__message--disconnected">
			<span class="elnsmwadapterui-status__indicator elnsmwadapterui-status__indicator--disconnected">●</span> Service unavailable or not responding
		</div>
		{{/connected}}
	</div>
	<div class="elnsmwadapterui-section">
		<h2 class="elnsmwadapterui-section-title elnsmwadapterui-section__title">{{legend}}</h2>
		<div class="elnsmwadapterui-form-content elnsmwadapterui-form__content">
			<p class="elnsmwadapterui-form-description elnsmwadapterui-form__description">{{help}}</p>
			<form method="get" action="{{action}}">
				<div class="elnsmwadapterui-form-field elnsmwadapterui-form__field">
					<label class="elnsmwadapterui-form-label elnsmwadapterui-form__label">{{label}}</label>
					<select name="eln-type" class="elnsmwadapterui-form-select elnsmwadapterui-form__select" required>
						{{#options}}
						<option value="{{value}}"{{#selected}} selected{{/selected}}>{{text}}</option>
						{{/options}}
					</select>
				</div>
				{{> submit-button}}
			</form>
		</div>
	</div>
</div>
