<div class="elnsmwadapterui-results">
	<h2>{{protocolsTitle}}</h2>
	{{#hasProtocols}}
	<ul>
		{{#protocols}}
		<li><a href="{{url}}" target="_blank" rel="noopener noreferrer">{{pageId}}</a></li>
		{{/protocols}}
	</ul>
	<p>{{summary}}</p>
	{{/hasProtocols}}
	{{^hasProtocols}}
	<p>{{noProtocolsText}}</p>
	{{/hasProtocols}}
	<h2>{{logTitle}}</h2>
	{{#hasLogMessages}}
	<ul class="elnsmwadapterui-log">
		{{#logMessages}}
		<li class="elnsmwadapterui-log__item elnsmwadapterui-log__item--{{cssClass}}"><strong>[{{type}}]</strong> {{text}}</li>
		{{/logMessages}}
	</ul>
	{{/hasLogMessages}}
	{{^hasLogMessages}}
	<p>{{noLogText}}</p>
	{{/hasLogMessages}}
	<p>{{{backButton}}}</p>
</div>
